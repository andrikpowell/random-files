#library "RUSTCOMP"
#include "zcommon.acs"
#include "GetSrcPort.acs" // must put code from SRCPORT into file "GetSrcPort.acs" next to "zcommon.acs" when compiling

Script "RUST_E1M8_Compat_Spider" OPEN {

	if (GetCVar("rust_e1m8_compat_disable") > 0) 
		Terminate;

	if ((GetSrcPort() == PORT_ZDOOM) || (GetSrcPort() == PORT_GZDOOM) || (GetSrcPort() == PORT_LZDOOM) || (GetSrcPort() == PORT_ZANDRONUM) || (GetSrcPort() == PORT_ZDAEMON) || (GetSrcPort() == PORT_ETERNITY))
		{		
			int mapLump = GetLevelInfo (LEVELINFO_LEVELNUM);
			if (mapLump == 8) {
				// add boss action
				//Log(s:"Masterminds: ",d:(ThingCountName("Arachnotron",0)));
				While(ThingCountName("Arachnotron", 0) > 0)
				Delay(35);
				//Log(s:"Spiders dead, lowering floor");
				Floor_LowerToLowest(666, 8);
			}
	}
}

Script "RUST_E1M8_Compat_Cyber" OPEN {

	if (GetCVar("rust_e1m8_compat_disable") > 0) 
		Terminate;

	if ((GetSrcPort() == PORT_ZDOOM) || (GetSrcPort() == PORT_GZDOOM) || (GetSrcPort() == PORT_LZDOOM) || (GetSrcPort() == PORT_ZANDRONUM) || (GetSrcPort() == PORT_ZDAEMON) || (GetSrcPort() == PORT_ETERNITY))
